# ---------------------------------------------------------------------------
# Aster — real Chrome agent (Python backend)
# Copy to `.env` and fill in ONE LLM provider.
# ---------------------------------------------------------------------------

# LLM provider: openai | google | anthropic | ollama | openai-compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Local Ollama / any OpenAI-compatible endpoint ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=local

# ---------------------------------------------------------------------------
# Your REAL Chrome
# ---------------------------------------------------------------------------
# The profile the agent must drive. "Default" is the normal personal profile.
CHROME_PROFILE_DIR=Default
# Optional explicit paths (used if Browser.from_system_chrome() is unavailable).
# macOS:
# CHROME_USER_DATA_DIR=/Users/you/Library/Application Support/Google/Chrome
# CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows:
# CHROME_USER_DATA_DIR=C:\Users\you\AppData\Local\Google\Chrome\User Data
# CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux:
# CHROME_USER_DATA_DIR=/home/you/.config/google-chrome
# CHROME_EXECUTABLE=/usr/bin/google-chrome

# Keep the browser open after the run (useful while debugging)
KEEP_BROWSER_OPEN=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
MAX_STEPS=25
# Comma separated origins allowed to call this API (the Vite dev server + build)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional shared token. When set, the frontend must send it in the
# `x-agent-token` header (Settings → Real Chrome agent → Access token).
AGENT_TOKEN=

# Serve the built frontend (../dist) from this backend on the same port
SERVE_FRONTEND=true
