# Local Next.js development for the Aster backend (server/). Copy to .env.local.
# Client only (Vite): npm run dev — no secrets needed, it uses the local demo engine.

# Single-admin gate used by /api/auth/login and the auth middleware
ADMIN_PASSWORD=change-me

# Live model answers (optional — chat falls back to the demo model)
GEMINI_API_KEY=

# Postgres connection for conversations / runs / projects (see db/schema.sql)
DATABASE_URL=

# Optional model routing
MODEL_PROVIDER=gemini
